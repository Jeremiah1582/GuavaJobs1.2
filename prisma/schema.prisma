// Merged InternHunt + GuavaJobs schema (Wave 0A) — Postgres on Supabase.
// Generator output: src/generated/prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserTier {
  FREEMIUM
  STARTER
  PRO
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  WAITING
  INTERVIEW
  OFFER
  ACCEPTED
}

enum ApplicationRejectionPhase {
  PRE_INTERVIEW
  POST_INTERVIEW
}

enum CoverLetterSource {
  MANUAL
  AI
}

enum JobCategory {
  ENGINEERING
  PRODUCT
  DESIGN
  DATA
  OTHER
  UNKNOWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  UNKNOWN
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  PROFESSIONAL
  FLUENT
  NATIVE
}

enum RightToWorkStatus {
  UK_CITIZEN
  SETTLED_STATUS
  PRE_SETTLED
  SKILLED_WORKER
  STUDENT_VISA
  NEEDS_SPONSORSHIP
  OTHER
  PREFER_NOT_TO_SAY
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum RelocationWillingness {
  NONE
  LOCAL
  NATIONAL
  INTERNATIONAL
}

enum SalaryPeriod {
  ANNUAL
  MONTHLY
  HOURLY
}

// ─── GuavaJobs user (Supabase auth.users.id) ─────────────────────────────────

model User {
  id                     String    @id @db.Uuid
  email                  String    @unique
  displayName            String?
  tier                   UserTier  @default(FREEMIUM)
  aiLettersUsedThisMonth Int       @default(0)
  aiUsagePeriodStart     DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  profile            Profile?
  applications       Application[]
  savedJobSearches    SavedJobSearch[]
  resumes            Resume[]
  jobs               Job[]
  jobMatches         JobMatch[]
  savedJobs          SavedJob[]
  appliedJobs        AppliedJob[]
  legacyCoverLetters LegacyCoverLetter[]
  chatMessages       ChatMessage[]

  @@map("users")
}

model Profile {
  userId                   String                 @id @db.Uuid
  summary                  String?
  headline                 String?
  location                 String?
  avatarUrl                String?
  phone                    String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  region                   String?
  postalCode               String?
  country                  String?
  websiteUrl               String?
  linkedInUrl              String?
  githubUrl                String?
  aspiringRole             String?
  personalityType          String?
  languagesJson            Json?
  salaryCurrency           String?                @default("GBP")
  salaryMin                Int?
  salaryMax                Int?
  salaryPeriod             SalaryPeriod?          @default(ANNUAL)
  salaryNegotiable         Boolean                @default(false)
  rightToWork              RightToWorkStatus?
  rightToWorkNote          String?
  noticePeriodWeeks        Int?
  availableFrom            DateTime?
  targetSeniority          SeniorityLevel?
  employmentTypePreference EmploymentType?
  relocationWillingness    RelocationWillingness?
  experienceJson           Json?
  skills                   String[]               @default([])
  educationJson            Json?
  cvFileUrl                String?
  quizJson                 Json?
  lastImportedAt           DateTime?
  lastImportSourceUrl      String?
  importMetaJson           Json?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Application {
  id                     String                     @id @default(uuid()) @db.Uuid
  userId                 String                     @db.Uuid
  status                 ApplicationStatus          @default(DRAFT)
  rejectionPhase         ApplicationRejectionPhase?
  rejectedAt             DateTime?
  company                String
  title                  String
  jobExternalId          String?
  jobUrl                 String?
  source                 String?
  location               String?
  salaryText             String?
  nextStep               String?
  contactName            String?
  viaRecruiter           Boolean                    @default(false)
  fitScore               String?
  industry               String?
  jobCategory            JobCategory                @default(UNKNOWN)
  jobCategoryOther       String?
  employmentType         EmploymentType             @default(UNKNOWN)
  requirementsNotes      String?                    @db.Text
  aboutNotes             String?                    @db.Text
  language               String?
  roleStartDate          DateTime?
  interviewRound         Int?
  interviewScheduledAt   DateTime?
  interviewLocation      String?
  interviewUrl           String?
  jobDescriptionSnapshot String?                    @db.Text
  jobListingSnapshot     Json?
  jobDescriptionText     String?                    @db.Text
  appliedAt              DateTime?
  resumeId               String?
  coverLetterId          String?                    @unique @db.Uuid
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume          Resume?                      @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter     ApplicationCoverLetter?      @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  timelineNotes   ApplicationNote[]
  profileSnapshot ApplicationProfileSnapshot?

  @@unique([userId, jobExternalId])
  @@index([userId])
  @@map("applications")
}

model ApplicationCoverLetter {
  id           String            @id @default(uuid()) @db.Uuid
  content      String            @db.Text
  source       CoverLetterSource @default(MANUAL)
  citationsJson Json?            @map("citations_json")
  isUserEdited Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  application Application?

  @@map("application_cover_letters")
}

model ApplicationProfileSnapshot {
  applicationId  String   @id @db.Uuid
  summary        String?  @db.Text
  experienceJson Json?
  skills         String[] @default([])
  educationJson  Json?
  snapshotAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_profile_snapshots")
}

model ApplicationNote {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @db.Uuid
  body          String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_notes")
}

model SavedJobSearch {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String
  q          String?
  where      String?
  country    String   @default("gb")
  distanceKm Int?
  maxDaysOld Int?
  sortBy     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_job_searches")
}

// ─── InternHunt legacy (Int ms timestamps, JSON string columns) ─────────────

model Resume {
  id         String  @id
  userId     String  @map("user_id") @db.Uuid
  filename   String
  filepath   String
  rawText    String  @map("raw_text")
  skills     String  @default("[]")
  keywords   String  @default("[]")
  strengths  String  @default("[]")
  feedback   String  @default("[]")
  experience String  @default("[]")
  education  String  @default("[]")
  atsScore   Int?    @map("ats_score")
  summary    String?
  isActive   Int     @default(1) @map("is_active")
  uploadedAt Int     @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint")) @map("uploaded_at")
  metadata   String  @default("{}")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobMatches         JobMatch[]
  legacyCoverLetters LegacyCoverLetter[]
  applications       Application[]

  @@index([userId], map: "resumes_userId_idx")
  @@map("resumes")
}

model Job {
  id             String  @id
  userId         String? @map("user_id") @db.Uuid
  title          String
  company        String
  location       String  @default("")
  locationType   String  @default("Unknown") @map("location_type")
  description    String  @default("")
  url            String
  source         String
  requiredSkills String  @default("[]") @map("required_skills")
  postedAt       Int?    @map("posted_at")
  scrapedAt      Int     @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint")) @map("scraped_at")
  isActive       Int     @default(1) @map("is_active")

  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobMatches         JobMatch[]
  legacyCoverLetters LegacyCoverLetter[]

  @@index([userId], map: "jobs_userId_idx")
  @@index([source], map: "jobs_source_idx")
  @@index([company], map: "jobs_company_idx")
  @@map("jobs")
}

model JobMatch {
  id          String @id
  userId      String @map("user_id") @db.Uuid
  jobId       String @map("job_id")
  resumeId    String @map("resume_id")
  matchScore  Int    @map("match_score")
  matchReason String @default("") @map("match_reason")
  computedAt  Int    @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint")) @map("computed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId], map: "job_matches_userId_idx")
  @@index([jobId], map: "job_matches_jobId_idx")
  @@map("job_matches")
}

model SavedJob {
  id            String @id
  userId        String @map("user_id") @db.Uuid
  jobExternalId String @map("job_external_id")
  source        String
  snapshot      String @default("{}")
  savedAt       Int    @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint")) @map("saved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobExternalId], map: "saved_jobs_user_job_idx")
  @@index([userId], map: "saved_jobs_userId_idx")
  @@map("saved_jobs")
}

model AppliedJob {
  id            String @id
  userId        String @map("user_id") @db.Uuid
  jobExternalId String @map("job_external_id")
  source        String
  appliedAt     Int    @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint")) @map("applied_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobExternalId], map: "applied_jobs_user_job_idx")
  @@index([userId], map: "applied_jobs_userId_idx")
  @@map("applied_jobs")
}

model LegacyCoverLetter {
  id          String @id
  userId      String @map("user_id") @db.Uuid
  jobId       String @map("job_id")
  resumeId    String @map("resume_id")
  content     String
  tone        String @default("professional")
  generatedAt Int    @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint")) @map("generated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId], map: "legacy_cover_letters_userId_idx")
  @@map("legacy_cover_letters")
}

model ChatMessage {
  id        String @id
  userId    String @map("user_id") @db.Uuid
  role      String
  content   String
  createdAt Int    @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "chat_messages_userId_idx")
  @@map("chat_messages")
}

model ScrapeRun {
  id         String  @id
  startedAt  Int     @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint")) @map("started_at")
  finishedAt Int?    @map("finished_at")
  jobsFound  Int?    @default(0) @map("jobs_found")
  status     String  @default("running")
  error      String?

  @@map("scrape_runs")
}
